    "serve": "firebase emulators:start --only functions",
    "serve-local": "node ./node_modules/firebase-tools/lib/bin/firebase.js emulators:start --only functions",
    "start": "npm run build && firebase deploy --only functions"
  },
  "engines": {
    "node": "18"
  },
  "main": "lib/index.js",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "firebase-admin": "^11.10.0",
    "firebase-functions": "^4.4.0"
  },
  "optionalDependencies": {
    "google-auth-library": "^8.9.0"
  },
  "devDependencies": {
    "firebase-tools": "^15.1.0",
    "typescript": "^5.0.4"
  }
}
